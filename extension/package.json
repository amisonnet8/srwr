{
  "name": "srwr-view",
  "displayName": "srwr-view",
  "description": "%extension.description%",
  "version": "0.1.9",
  "publisher": "amisonnet8",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/amisonnet8/srwr" },
  "homepage": "https://github.com/amisonnet8/srwr#readme",
  "bugs": { "url": "https://github.com/amisonnet8/srwr/issues" },
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#0d1117", "theme": "dark" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Other"],
  "keywords": ["ai", "agent", "mcp", "claude", "claude-code", "replay", "code-review", "audit", "vim", "srwr"],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "srwr.openTape", "title": "%srwr.openTape.title%", "icon": "$(folder-opened)" },
      { "command": "srwr.closeTape", "title": "%srwr.closeTape.title%", "icon": "$(close)" },
      { "command": "srwr.stepForward", "title": "%srwr.stepForward.title%" },
      { "command": "srwr.stepBack", "title": "%srwr.stepBack.title%" },
      { "command": "srwr.goto", "title": "%srwr.goto.title%" },
      { "command": "srwr.liveStart", "title": "%srwr.liveStart.title%", "icon": "$(broadcast)" },
      { "command": "srwr.liveStop", "title": "%srwr.liveStop.title%" },
      { "command": "srwr.liveLatest", "title": "%srwr.liveLatest.title%" },
      { "command": "srwr.chooseKinds", "title": "%srwr.chooseKinds.title%", "icon": "$(filter)" }
    ],
    "colors": [
      {
        "id": "srwr.failureForeground",
        "description": "%color.failure.description%",
        "defaults": { "dark": "#ff3b30", "light": "#d50000", "highContrast": "#ff3b30", "highContrastLight": "#d50000" }
      }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "srwr", "title": "srwr", "icon": "media/srwr.svg" }]
    },
    "views": {
      "srwr": [{ "id": "srwr.ops", "name": "%view.ops.name%" }]
    },
    "viewsWelcome": [
      {
        "view": "srwr.ops",
        "contents": "%view.ops.welcome%",
        "when": "!srwr.hasTape"
      }
    ],
    "menus": {
      "commandPalette": [{ "command": "srwr.goto", "when": "false" }],
      "view/title": [
        { "command": "srwr.openTape", "when": "view == srwr.ops", "group": "navigation@1" },
        { "command": "srwr.liveStart", "when": "view == srwr.ops", "group": "navigation@2" },
        { "command": "srwr.chooseKinds", "when": "view == srwr.ops && srwr.hasTape", "group": "navigation@3" },
        { "command": "srwr.closeTape", "when": "view == srwr.ops && srwr.hasTape", "group": "navigation@4" }
      ]
    },
    "configuration": {
      "title": "srwr",
      "properties": {
        "srwr.path": {
          "type": "string",
          "default": "srwr",
          "description": "%config.path.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "node --test --require ./out/test/setup.js \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
