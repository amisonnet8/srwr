# Entry points for building and checking this project (.claude/rules/testing.md).
# qsoku always runs these with sh, so every entry works the same no matter which
# shell called it.

build: (cd //; go build ./...)

# Rewrite files with the formatters enabled in .golangci.yaml.
fmt: (cd //; golangci-lint fmt)

vet: (cd //; go vet ./...)

# Also reports files that the formatters would change.
lint: (cd //; golangci-lint run)

unit: (cd //; go test ./...)

# Go only (vet, lint, unit). CI runs this on three OSes.
go-check: qsoku vet && qsoku lint && qsoku unit

# Type-checks and lints for the other OSes CI runs on (Windows, macOS). A Unix-only call such as
# syscall.Flock only fails there. Tests cannot run on another OS; CI does that.
cross: (cd //; for os in windows darwin; do echo "== GOOS=$os"; GOOS=$os go vet ./... && GOOS=$os golangci-lint run || exit 1; done)

# The VSCode extension (srwr-view, extension/). Skipped while extension/package.json does not exist
# yet (extension/test/ already holds the fixtures and golden data).
ext-deps: (cd //; cd extension && if [ -f package-lock.json ]; then npm ci; else npm install; fi)
ext-build: (cd //; if [ -f extension/package.json ]; then cd extension && { [ -d node_modules ] || qsoku ext-deps; } && npm run compile; else echo 'extension/package.json does not exist yet; skipped'; fi)
# Builds bin/srwr first: the extension's tests talk to the real display server.
ext: (cd //; if [ -f extension/package.json ]; then qsoku bin && cd extension && { [ -d node_modules ] || qsoku ext-deps; } && npm run compile && npm test; else echo 'extension/package.json does not exist yet; skipped'; fi)

# Runs every check of the UI (the tests behind each item of handoff/checklist/CHECKLIST.md 2章, the screens of the Vim client and of
# the extension against their baselines, the tape of a long why made on the spot) and makes the page to look at:
# ui-check-result/latest/index.html. Exit code 1 when a check failed or a screen differs. VIM_BIN names another Vim.
ui-check: (cd //; qsoku bin && qsoku ext-build && go run ./tools/ui-check run)

# The same for the live view only. `qsoku ui-live --watch vim` (or vscode) instead opens the live view for a person to feel it.
ui-live: (cd //; qsoku bin && { [ "$1" = --watch ] || qsoku ext-build; } && go run ./tools/ui-check live "$@")

# Records what the person decided about the last qsoku ui-check: `qsoku ui-accept` (OK: the screens become the baseline),
# `qsoku ui-accept ng <note>` (the baseline stays).
ui-accept: (cd //; go run ./tools/ui-check accept "$@")

# R7: a workspace for Claude Code to work in (two bugs, srwr mcp and srwr hook registered, the lenient mode), opened in VSCode.
# After the work, shows what was recorded and plays the tape in Vim. For a person to run in their terminal.
hook-try: (cd //; qsoku bin && go run ./tools/ui-check hook-try)

# R9: a workspace that already has its own .mcp.json and .claude/settings.json gets `srwr init`; the person's Claude Code works in it
# with only what init wrote (the strict mode), and the files, the second run of init and the tape are checked. Page: ui-check-result/init-try/index.html.
# For a person to run in their terminal.
init-try: (cd //; qsoku bin && go run ./tools/ui-check init-try)

# qsoku readme-media: makes the pictures of the README (docs/images/, extension/media/readme/) and the page to look at
readme-media: (cd //; qsoku bin && go run ./tools/ui-check readme)

# Opens the fixed workspace in a real VSCode with the extension installed, for a person to look at (.claude/rules/working-with-human.md).
# qsoku ui-open <vscode|vim> <why-basic|external|no-why|live>
ui-open: (cd //; qsoku bin && { [ "$1" != vscode ] || qsoku ext-build; } && go run ./tools/ui-check open "$@")

# Vim client tests (vim/test/test_*.vim) in a headless Vim. Each test ends with
# qall! on success or cquit on failure. -c 'cquit 2' and </dev/null keep a test that
# errors halfway from waiting for input in Ex mode. The tests talk to the real display server, so bin/srwr is built first.
# Then the screens of a real Vim on a terminal (vim/screen_test.go) are compared with vim/test/baseline.
# VIM_BIN names another Vim to test with (vim-oldest does).
# Skipped while vim/test/ does not exist yet.
vim-test: (cd //; if [ -d vim/test ]; then qsoku bin && rc=0; for t in vim/test/test_*.vim; do [ -e "$t" ] || continue; echo "== $t"; ${VIM_BIN:-vim} -Nu NONE -i NONE -Es -V1 -S "$t" -c 'cquit 2' </dev/null || rc=1; done; echo "== screens (a real Vim on a terminal)"; SRWR_SCREEN_TEST=1 go test -count=1 ./vim/ ./internal/uicheck/ || rc=1; [ "$rc" -eq 0 ]; else echo 'vim/test/ does not exist yet; skipped'; fi)

# Everything to pass at each stopping point: Go, the other OSes, the extension and the Vim client.
check: qsoku go-check && qsoku cross && qsoku ext && qsoku vim-test

# -race needs cgo, which the container turns off (.devcontainer/devcontainer.json).
race: (cd //; CGO_ENABLED=1 go test -race -count=1 ./...)

# Builds bin/srwr for this machine (ignored by git).
bin: (cd //; go build -o bin/srwr ./cmd/srwr)

trivy: (cd //; trivy fs --config trivy.yaml .)

shellcheck: (cd //; git ls-files '*.sh' '*.bash' | xargs -r shellcheck)

# The oldest Vim srwr-view.vim supports (9.0.0784, docs/reference/vim.md): built from source once, then vim-test runs with it.
# SRWR_VIM_OLDEST_DIR says where to build it (the default is under the user cache; a sandbox that cannot write there can name another).
vim-oldest: (cd //; sh tools/vim-oldest.sh)
