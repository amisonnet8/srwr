# Paths that crube leaves out of ls, tree, find and status.
# The format is that of .gitignore, but .gitignore itself is not read.
# .crube/ is always left out.
.git/
.hg/
.svn/
node_modules/

# What this repository does not commit, following .gitignore by hand (crube
# does not read it): when .gitignore changes, change this file too.

# Build artifacts.
/bin/
/dist/
/ui-check
*.exe
*.test
*.out

# VSCode extension (srwr-view): dependencies, compiled output, packages.
/extension/node_modules/
/extension/out/
*.vsix

# Things a person puts in the root for an experiment: never committed.
/*.tape.jsonl.gz
/*.jsonl
/checksums.txt

# Results of qsoku ui-check (the baselines are committed; the results are not).
/ui-check-result/

# Dot entries in the root (and in .claude/): leave out all of them, then take
# back only what is committed. This also leaves out the dummy files that the
# Bash sandbox puts in the working directory (.claude/rules/testing.md).
/.*
!/.gitignore
!/.gitattributes
!/.srwrignore
!/.golangci.yaml
!/.goreleaser.yaml
!/.mcp.json
!/.devcontainer/
!/.github/
!/.mtqg/
!/.bcuz/
!/.vscode/
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/rules/
!/.claude/skills/
!/.claude/hooks/
# srwr: only the closed tapes are committed (never the key).
!/.srwr/
/.srwr/*
!/.srwr/tapes/
/.srwr/tapes/*.tape.jsonl
# The closed tapes are committed, but they are not described one by one: a
# pattern entry for them would be an orphan until the first tape is closed,
# and each new tape would be untracked without one.
/.srwr/tapes/*.tape.jsonl.gz
# mtqg: .local/ is not committed.
/.mtqg/.local/
