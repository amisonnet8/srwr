# Build artifacts (keep binaries out of the repository).
/bin/
/dist/
/ui-check
*.exe
*.test
*.out

# VSCode extension (srwr-view): dependencies, compiled output, packages.
/extension/node_modules/
/extension/out/
*.vsix

# Things a person puts in the root for an experiment (tapes, conversation files, checksums): never committed.
/*.tape.jsonl.gz
/*.jsonl
/checksums.txt

# Results of qsoku ui-check (the baselines are committed; the results are not).
/ui-check-result/

# Allowlist for dot entries in the repository root (and .claude/): ignore all
# of them, then re-include only what is tracked. This also covers the dummy
# /dev/null files that the Bash sandbox leaves in the working directory
# (.claude/rules/testing.md). A new tracked dot entry needs a "!" line here.
/.*
!/.gitignore
!/.gitattributes
!/.srwrignore
!/.golangci.yaml
!/.goreleaser.yaml
!/.mcp.json
!/.devcontainer/
!/.github/
!/.mtqg/
# The descriptions of this repository's files (crube, .claude/rules/crube-usage.md).
!/.crube/
# bcuz's record of the commands run (.claude/rules/bcuz-usage.md). Shared, like
# .mtqg/; .gitattributes merges it with merge=union.
!/.bcuz/
# Only to launch the extension with F5 (.claude/rules/directory-structure.md).
!/.vscode/

# .claude/: only the shared files (settings.local.json stays personal)
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/rules/
!/.claude/skills/
!/.claude/hooks/
# srwr (.claude/rules/srwr-usage.md). The closed tapes (.srwr/tapes/*.gz) are
# shared; everything else in .srwr/ stays local (the key must never be shared).
# A tape that is still being written (*.tape.jsonl) is not tracked: it turns
# into a .gz when it is closed, and tracking it would make that a delete + add.
!/.srwr/
/.srwr/*
!/.srwr/tapes/
/.srwr/tapes/*.tape.jsonl
# The four lines below are what `srwr init` looks for; without them it would
# append them again each time.
.srwr/key
.srwr/lock
.srwr/active
.srwr/init-backup/
